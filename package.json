{
  "name": "pensjonskalkulator-microfrontend-ssr",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm build && NODE_ENV=development node dist/index.js",
    "start": "node dist/index.js",
    "build": "node scripts/build.js",
    "test": "pnpm build && node --test",
    "lint": "eslint '**/*.js'",
    "prettier": "prettier --write 'src/**/*.ts' 'templates/*.{html,css}' 'scripts/*.js' 'test/*.js'"
  },
  "devDependencies": {
    "@navikt/ds-css": "6.16.2",
    "@types/node": "24.1.0",
    "eslint": "^10.14.0",
    "postcss": "^8.5.14",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "3.3.3",
    "typescript": "5.3.3"
  }
}
